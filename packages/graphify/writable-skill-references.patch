+def _make_directories_owner_writable(path: Path) -> None:
+    """Undo read-only directory modes inherited from immutable package stores."""
+    if not path.exists():
+        return
+    for root, directories, _files in os.walk(path):
+        root_path = Path(root)
+        root_path.chmod(root_path.stat().st_mode | 0o300)
+        for directory in directories:
+            directory_path = root_path / directory
+            directory_path.chmod(directory_path.stat().st_mode | 0o300)
+
+
+def _remove_skill_references(path: Path) -> None:
+    _make_directories_owner_writable(path)
+    shutil.rmtree(path)
